{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/campaigns.ts": {
      "maxDuration": 30
    },
    "api/donations.ts": {
      "maxDuration": 30
    },
    "api/kora.ts": {
      "maxDuration": 30
    },
    "api/profile.ts": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/((?!api/|src/|@react-refresh|@vite/|node_modules/|.*\\.[^/]*$).*)", "destination": "/index.html" }
  ]
}
